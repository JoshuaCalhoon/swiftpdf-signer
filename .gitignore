# Business-sensitive source materials — never commit
references/

# Generated PDFs from references (the actual signed-form template lives here at build time
# but contains business content we don't want to publish)
Resources/*.pdf

# Xcode / build artifacts.
# Ignore everything inside *.xcodeproj/* but re-include the SPM lockfile
# (Package.resolved) so dependency versions are reproducible from a clone.
# Order of rules matters — walk each subdirectory open with a `!` then
# re-exclude its other contents, until the leaf file gets re-included.
*.xcodeproj/*
!*.xcodeproj/project.xcworkspace/
*.xcodeproj/project.xcworkspace/*
!*.xcodeproj/project.xcworkspace/xcshareddata/
*.xcodeproj/project.xcworkspace/xcshareddata/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
# Anchored to repo root so the *.xcworkspace nested inside .xcodeproj/
# (handled by the negation chain above) isn't accidentally re-ignored.
/*.xcworkspace/
DerivedData/
build/
.build/
xcuserdata/
*.xcuserstate
*.swiftpm/

# xcodegen-generated Info.plist (regenerated by `xcodegen generate`)
SwiftPDF-Info.plist

# Secrets
Secrets.swift
Secrets.xcconfig
Configuration/Local.xcconfig
# (Configuration/Local.xcconfig.example IS committed as a template — name doesn't match the ignore.)

# System
.DS_Store
*.swp

# IDE
.vscode/
.idea/

# Code/security review artifacts — generated locally, kept out of git.
# Consolidated under reviews/ so dated backups and cross-reference docs stay together.
reviews/
.gstack/

# Project-memory workflow files — local context for AI coding sessions, not for publication.
# Contains: architecture.md, design.md, mapfile.md, nextchat.md, project-memory.md, to-do.md.
internal/
