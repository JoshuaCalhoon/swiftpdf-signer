# Business-sensitive source materials — never commit
references/

# Generated PDFs from references (the actual signed-form template lives here at build time
# but contains business content we don't want to publish)
Resources/*.pdf

# Xcode / build artifacts
*.xcodeproj/
*.xcworkspace/
DerivedData/
build/
.build/
xcuserdata/
*.xcuserstate
*.swiftpm/

# xcodegen-generated Info.plist (regenerated by `xcodegen generate`)
SwiftPDF-Info.plist

# Swift Package Manager
Package.resolved

# Secrets
Secrets.swift
Secrets.xcconfig
Configuration/Local.xcconfig
# (Configuration/Local.xcconfig.example IS committed as a template — name doesn't match the ignore.)

# System
.DS_Store
*.swp

# IDE
.vscode/
.idea/
